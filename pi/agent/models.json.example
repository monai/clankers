          "input": ["text", "image"],
          "contextWindow": 131072,
          "maxTokens": 114688,
          "samplingParams": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0
          },
          "compat": {
            "thinkingFormat": "qwen-chat-template",
            "maxTokensField": "max_tokens"
