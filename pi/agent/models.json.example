          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 131072,
          "maxTokens": 114688,
          "compat": {
            "thinkingFormat": "qwen-chat-template",
            "maxTokensField": "max_tokens"
          },
          "chatTemplateKwargs": {
            "enable_thinking": { "$var": "thinking.enabled", "omitWhenOff": true },
            "reasoning_effort": { "$var": "thinking.effort" }
          }
        }
      ]
    },
    "mlx-coder": {
